# Duli Interiors — environment template.
# Copy to .env.local and fill values. .env.local is gitignored (never commit secrets).
# NEXT_PUBLIC_* is exposed to the browser; everything else is server-only.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth, database, storage) — create a project at supabase.com (India region)
# Supports the new key format (sb_publishable_...) or the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. New format: sb_secret_...
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (AI analysis / generation) — server-only, never exposed to the browser
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash (multimodal: room photos + floor plans).
GEMINI_VISION_MODEL=

# 21st.dev MCP (component search) — real value lives in .env.local
TWENTYFIRST_API_KEY=

# Resend — transactional email (server-only). Get a key at resend.com.
RESEND_API_KEY=
# From address. Use onboarding@resend.dev in test mode; switch to your own
# verified domain (e.g. no-reply@duliinteriors.com) to email arbitrary people.
RESEND_FROM=Duli Interiors <onboarding@resend.dev>
# Where team/admin alert emails land (new project, consultation request).
DULI_TEAM_EMAIL=
